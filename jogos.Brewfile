################################################################################
# Lista de jogos recomendados para instalação via Homebrew no Linux            #
#                                                                              #
# RECOMENDAÇÃO:                                                                #
# Utilize com imagens do Universal Blue (Bazzite, Bluefin e Aurora).           #
# Downloads em https://universal-blue.org/                                     #
#                                                                              #
# INFORMAÇÕES:                                                                 #
# - Se não utilizar imagem do Universal Blue, instale antes o Homebrew         #
#   conforme https://brew.sh/                                                  #
# - Todos os jogos são instalados via Flatpak, a partir do Flathub.            #
# - Os jogos estão divididos por categoria e em ordem alfabética.              #
# - O Bazzite já traz a Steam instalada; nele, comente a linha da Steam.       #
# - Exclua ou comente o que não for necessário.                                #
# - Uso: brew bundle --file [caminho para jogos.Brewfile]                      #
# - Documentação: https://docs.brew.sh/Brew-Bundle-and-Brewfile                #
#                                                                              #
# Licença: CC0-1.0. Pedro Henrique Quitete Barreto 2026                        #
################################################################################

################################################################################
# LOJAS E LAUNCHERS                                                            #
################################################################################

flatpak "com.heroicgameslauncher.hgl"                      # Heroic Games Launcher: launcher para jogos da Epic Games, GOG e Amazon Prime Gaming
flatpak "com.valvesoftware.Steam"                          # Steam: loja e launcher de jogos da Valve

################################################################################
# JOGOS                                                                        #
################################################################################

# Corrida
flatpak "net.sourceforge.ExtremeTuxRacer"                  # Extreme Tux Racer: corrida de trenó morro abaixo com o Tux
flatpak "net.supertuxkart.SuperTuxKart"                    # SuperTuxKart: corrida de kart em 3D, com o Tux e mascotes de software livre

# Esporte
flatpak "org.kde.kolf"                                     # Kolf: minigolfe do KDE, com obstáculos, lagos e bancos de areia

# Estratégia e Simulação
flatpak "com.play0ad.zeroad"                               # 0 A.D.: estratégia em tempo real ambientada na Antiguidade
flatpak "com.github.keriew.augustus"                       # Augustus: versão aprimorada de Caesar III (exige os arquivos do jogo original)
flatpak "io.openrct2.OpenRCT2"                             # OpenRCT2: reimplementação de RollerCoaster Tycoon 2 (exige os arquivos do jogo original)

# Plataforma
flatpak "org.supertuxproject.SuperTux"                     # SuperTux: jogo de plataforma em 2D com o Tux, no estilo Super Mario

# Tiro
flatpak "org.xonotic.Xonotic"                              # Xonotic: tiro em primeira pessoa em arenas, rápido e livre
